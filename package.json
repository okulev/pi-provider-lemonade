{
  "name": "pi-provider-lemonade",
  "version": "1.0.0",
  "description": "pi extension that auto-discovers downloaded models from a Lemonade Server and exposes them through its OpenAI-compatible API",
  "type": "module",
  "license": "MIT",
  "author": "Ognyan Kulev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okulev/pi-provider-lemonade.git"
  },
  "homepage": "https://github.com/okulev/pi-provider-lemonade#readme",
  "bugs": {
    "url": "https://github.com/okulev/pi-provider-lemonade/issues"
  },
  "keywords": [
    "pi-package",
    "lemonade-server",
    "local-llm",
    "provider",
    "auto-discovery"
  ],
  "files": [
    "index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.5": true,
    "esbuild@0.28.1": true
  }
}
